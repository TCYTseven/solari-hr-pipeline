# Copy to .env and fill in. .env is gitignored; never commit it.

# --- Required ---------------------------------------------------------------

# Claude (triage, the demo agent and scoring). https://console.anthropic.com
ANTHROPIC_API_KEY=
# Postgres. `npm run setup` generates POSTGRES_PASSWORD and fills this in for you.
DATABASE_URL=postgres://screener:screener@localhost:5432/solari_screener
POSTGRES_PASSWORD=

# --- Solari ------------------------------------------------------------------

# With a key, builds run in Solari Sandboxes and demos in Solari Browsers and
# Desktops. Without one, the pipeline falls back to local Docker + Chromium.
SOLARI_API_KEY=
# SOLARI_BASE_URL=https://api.getsolari.com
# Set to "package" only if `npm run solari:check` tells you to (Node 22's
# built-in WebSocket can't send the Solari auth header on some setups).
# SOLARI_WS=native

# --- Secrets handed to submissions -------------------------------------------
# Submissions are untrusted code and never see the keys above. Anything named
# SUBMISSION_<NAME> is passed into every submission as <NAME>. Most Solari
# projects need a Solari key to run at all; use one with a spend cap.
# SUBMISSION_SOLARI_API_KEY=
# SUBMISSION_ANTHROPIC_API_KEY=

# --- Dashboard ---------------------------------------------------------------

# Secret for the private review page: /review?key=<REVIEW_KEY>. Unset = disabled.
REVIEW_KEY=change-me
# Footer links.
# NEXT_PUBLIC_REPO_URL=https://github.com/TCYTseven/solari-hr-pipeline
# NEXT_PUBLIC_X_URL=

# --- Screening (defaults shown) ------------------------------------------------

# SCREENER_UPSTREAM=solari-sdk/solari-cookbook
# Raises GitHub's API limit from 60 to 5,000 requests an hour. No scopes needed.
# GITHUB_TOKEN=
# SCREENER_MODEL=claude-sonnet-5
# SCREENER_INTERVAL_MIN=30
# SCREENER_INSTALL_TIMEOUT_SEC=600
# SCREENER_MAX_RUN_TIMEOUT_SEC=300
# SCREENER_DEMO_MAX_ACTIONS=25
# SCREENER_DEMO_MAX_SEC=120
# Comma-separated owner/repo list that replaces GitHub discovery.
# SCREENER_FORKS=

# --- Local fallback (no SOLARI_API_KEY) ------------------------------------------

# SCREENER_DOCKER_IMAGE=solari-screener-sandbox:latest
# SCREENER_DOCKER_CPUS=2
# SCREENER_DOCKER_MEMORY=4g
# Chromium for local demos; defaults to Playwright's (npx playwright install chromium).
# CHROMIUM_PATH=

# --- Storage -------------------------------------------------------------------

# Where the pipeline writes clones and recordings; the dashboard serves /media from MEDIA_DIR.
# SCREENER_WORK_DIR=.screener/work
# MEDIA_DIR=.screener/media
# When the dashboard is hosted elsewhere (Vercel), sync MEDIA_DIR to a bucket and
# set its public URL here at build time; /media/* is then served from it.
# MEDIA_PUBLIC_URL=
# LISTEN needs a direct connection; set this if DATABASE_URL goes through a pooler.
# LIVE_DATABASE_URL=
