{
  "name": "solari-screener",
  "version": "0.1.0",
  "private": true,
  "description": "Every Solari submission, booted and demoed.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/db.mts migrate",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/db.mts seed",
    "db:reset": "node --env-file-if-exists=.env --import tsx scripts/db.mts reset",
    "sdk-issue": "node --env-file-if-exists=.env --import tsx scripts/sdk-issue.mts",
    "db:restore": "node --env-file-if-exists=.env --import tsx scripts/db.mts restore"
  },
  "dependencies": {
    "next": "16.3.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "simple-icons": "^16.33.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
